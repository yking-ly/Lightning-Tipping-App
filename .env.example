# Environment Configuration Template
# Copy this file to .env and fill in your values

# Application Settings
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# For SQLite (development): sqlite:///./tipping_app.db
# For PostgreSQL (production): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./tipping_app.db

# LNbits Configuration
# Get these from your LNbits wallet: https://legend.lnbits.com
LNBITS_URL=https://legend.lnbits.com
LNBITS_ADMIN_KEY=your-lnbits-admin-key-here
LNBITS_INVOICE_KEY=your-lnbits-invoice-key-here

# Webhook Configuration
# This should point to your publicly accessible URL
# For local development with ngrok: https://your-ngrok-url.ngrok.io/api/webhooks/payment
# For production: https://yourdomain.com/api/webhooks/payment
WEBHOOK_URL=http://localhost:8000/api/webhooks/payment

# Server Configuration
HOST=0.0.0.0
PORT=8000

# ============================================
# SETUP INSTRUCTIONS:
# ============================================
# 
# 1. LNbits Setup:
#    - Go to https://legend.lnbits.com
#    - Create a free account (no signup required)
#    - Click "Add a new wallet"
#    - Copy the Admin Key and Invoice/Read Key
#    - Paste them above
#
# 2. For Testnet (recommended for development):
#    - Use https://legend.lnbits.com (demo instance)
#    - Or set up your own LNbits instance with testnet
#
# 3. Secret Key:
#    - Generate a random secret key (32+ characters)
#    - You can use: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 4. Webhooks (for production):
#    - Set up ngrok for local testing: ngrok http 8000
#    - Update WEBHOOK_URL with your ngrok URL
#    - For production, use your actual domain
#
# ============================================
